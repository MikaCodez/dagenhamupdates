# Copy to .env.local and fill in. Nothing here is required to run the site —
# without it, everything falls back to the sample content in
# src/lib/content/*.ts. See site/README.md, "Content: Sanity CMS".

# --- Sanity -------------------------------------------------------------
# From sanity.io/manage after creating a free project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# A token with Editor access (sanity.io/manage → API → Tokens). Needed for
# scripts/migrate-to-sanity.ts and for /api/tip to write submissions.
# Server-only — never prefix this one with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# A token with Viewer (read-only) access. Powers the Live Content API
# (src/sanity/live.ts) and Draft Mode/Visual Editing — this one IS sent to
# the browser (defineLive's browserToken), which is why it must be Viewer,
# never Editor: create it separately from the write token above.
SANITY_API_READ_TOKEN=

# Shared secret for the Sanity → /api/revalidate webhook. Any random string.
SANITY_REVALIDATE_SECRET=

# The Studio's own origin (not this app's) — Presentation's live-preview
# iframe embeds this site cross-origin from there, so next.config.ts's CSP
# names it explicitly in frame-ancestors. Defaults to `sanity dev`'s port
# (3333) if unset; set this to the Studio's real URL once it's deployed.
SANITY_STUDIO_ORIGIN=http://localhost:3333

# --- Tip notification email (optional) -----------------------------------
# From resend.com. Without these, tips are still saved to Sanity (if
# configured above) but no email is sent.
RESEND_API_KEY=
TIP_NOTIFICATION_EMAIL=
TIP_FROM_EMAIL=

# --- Newsletter (listmonk) ------------------------------------------------
# Self-hosted — see ../listmonk/README.md. Without these, NewsletterForm.tsx
# shows an error instead of pretending to subscribe anyone.
LISTMONK_URL=http://localhost:9000
LISTMONK_LIST_UUID=

# --- Everything else, from the original build (unchanged) ----------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_GA_ID=
